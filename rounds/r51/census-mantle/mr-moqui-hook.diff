--- a/crates/moqui-core/src/script/oxide/engine.rs
+++ b/crates/moqui-core/src/script/oxide/engine.rs
@@ -1127,6 +1127,19 @@ impl OxideEngine {
 
 impl Drop for OxideEngine {
     fn drop(&mut self) {
+        // r51 census probe (local only): the runtime's atoms after a collection, before it goes
+        if std::env::var_os("QJS_ATOM_CENSUS").is_some() && !std::thread::panicking() {
+            let runtime = &self.runtime;
+            let address = std::ptr::from_ref(self) as usize;
+            let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                let _ = runtime.run_gc();
+                eprintln!(
+                    "atom census drop [{}] runtime={address:#x}",
+                    std::thread::current().name().unwrap_or("?"),
+                );
+                let _ = runtime.memory_report();
+            }));
+        }
         counts::LIVE.fetch_sub(1, Relaxed);
         counts::HEAP.fetch_sub(self.heap.get(), Relaxed);
         moqui_lib::sync::lock(&RUNTIME_HEAPS).remove(&(std::thread::current().id(), std::ptr::from_ref(self) as usize));
